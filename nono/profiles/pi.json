{
  "extends": "nolabs-ai/pi",
  "meta": {
    "name": "pi"
  },
  "filesystem": {
    "read": [
      "$HOME/.local/state/fnm_multishells",
      "$HOME/Development",
      "$HOME/Desktop",
      "$HOME/Documents",
      "$HOME/Downloads",
      "$HOME/.config/gh"
    ],
    "deny": [
      "$HOME/.pi/auth.json",
      "$HOME/.pi/models.json"
    ]
  },
  "env_credentials": {
    "keyring://gh:github.com/delvedor?decode=go-keyring": "GH_TOKEN"
  }
}
